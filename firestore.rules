rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // VitaLinks Plus entitlement + AI usage tracking. Deliberately kept off the
      // parent users/{userId} document (which the client's own whole-document sync
      // overwrites on every push) and writable only by Cloud Functions via the Admin
      // SDK, which bypasses these rules entirely. The client can read its own status
      // to render the paywall/settings UI, but can never set its own entitlement.
      match /private/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Health Connect daily sync (steps/heart rate/blood pressure aggregates). Unlike
      // private/**, the client writes this directly — there's nothing to server-verify for
      // on-device health data, unlike RevenueCat billing state. Kept as its own subcollection,
      // never touched by the whole-document users/{userId} sync, so a device sync can never
      // interact with that sync's fragile unmerged setDoc.
      match /healthConnect/{day} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    // In-app feedback + automatic client error reports (2026-09-07, ahead of the
    // 12-tester closed-testing round). Write-only from the client by design — these
    // are reviewed directly in the Firebase console, never read back by the app —
    // and gated on sign-in like foods/barcodeFoods below, the same tradeoff: a report
    // that happens to occur before a user ever signs in is silently dropped rather
    // than opening an unauthenticated write surface on a real production project.
    match /feedback/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /foods/{foodId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /barcodeFoods/{barcodeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
